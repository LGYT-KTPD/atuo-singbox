{
  "log": {
    "level": "error"
  },
  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "external_ui": "ui",
      "secret": "",
      "external_ui_download_url": "https://gh-proxy.com/https://github.com/MetaCubeX/metacubexd/archive/refs/heads/gh-pages.zip",
      "default_mode": "rule",
      "external_ui_http_client": "direct-download"
    },
    "cache_file": {
      "enabled": true
    }
  },
  "dns": {
    "servers": [
      {
        "tag": "google",
        "type": "tls",
        "server": "8.8.8.8",
        "detour": "Proxy",
        "strategy": "ipv4_only"
      },
      {
        "tag": "local",
        "type": "udp",
        "server": "223.5.5.5",
        "strategy": "ipv4_only"
      },
      {
        "tag": "public",
        "type": "https",
        "server": "dns.alidns.com",
        "domain_resolver": "local",
        "strategy": "ipv4_only"
      }
    ],
    "rules": [
      {
        "clash_mode": "direct",
        "action": "route",
        "server": "local"
      },
      {
        "clash_mode": "global",
        "action": "route",
        "server": "google"
      },
      {
        "domain_suffix": [
          "ghfast.top",
          "raw.githubusercontent.com",
          "github.com",
          "gh-proxy.com",
          "testingcf.jsdelivr.net",
          "cdn.jsdelivr.net",
          "ghproxy.net"
        ],
        "action": "route",
        "server": "local"
      },
      {
        "process_name": [
          "Weixin.exe",
          "WeChatAppEx.exe"
        ],
        "action": "route",
        "server": "local"
      },
      {
        "domain_suffix": [
          "weixin.qq.com",
          "wx.qq.com",
          "wechat.com",
          "qpic.cn",
          "qlogo.cn",
          "gtimg.com",
          "tenpay.com",
          "url.cn",
          "weiyun.com"
        ],
        "action": "route",
        "server": "local"
      },
      {
        "rule_set": "geosite-cn",
        "action": "route",
        "server": "local"
      },
      {
        "rule_set": "geosite-geolocation-!cn",
        "action": "route",
        "server": "google"
      }
    ],
    "reverse_mapping": false,
    "strategy": "ipv4_only",
    "final": "google"
  },
  "inbounds": [
    {
      "tag": "tun-in",
      "type": "tun",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "stack": "system",
      "auto_route": true,
      "strict_route": true,
      "dns_mode": "hijack",
      "endpoint_independent_nat": true,
      "udp_timeout": "5m0s"
    },
    {
      "tag": "mixed-in",
      "type": "mixed",
      "listen": "127.0.0.1",
      "listen_port": 7890
    }
  ],
  "outbounds": [
    {
      "tag": "Proxy",
      "type": "selector",
      "outbounds": [
        "__PROXY_PLACEHOLDER__",
        "direct"
      ],
      "default": "__PROXY_PLACEHOLDER__"
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "default_domain_resolver": "local",
    "auto_detect_interface": true,
    "final": "Proxy",
    "rules": [
      {
        "ip_version": 6,
        "action": "reject"
      },
      {
        "process_name": [
          "Weixin.exe",
          "WeChatAppEx.exe"
        ],
        "ip_version": 6,
        "action": "reject"
      },
      {
        "process_name": [
          "Weixin.exe",
          "WeChatAppEx.exe"
        ],
        "network": [
          "tcp",
          "udp"
        ],
        "outbound": "direct"
      },
      {
        "domain_suffix": [
          "weixin.qq.com",
          "wx.qq.com",
          "wechat.com",
          "qpic.cn",
          "qlogo.cn",
          "gtimg.com",
          "tenpay.com",
          "url.cn",
          "weiyun.com"
        ],
        "outbound": "direct"
      },
      {
        "inbound": [
          "tun-in",
          "mixed-in"
        ],
        "action": "sniff"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 53
          },
          {
            "protocol": "dns"
          }
        ],
        "action": "hijack-dns"
      },
      {
        "rule_set": "geosite-category-ads-all",
        "clash_mode": "rule",
        "action": "reject"
      },
      {
        "clash_mode": "direct",
        "outbound": "direct"
      },
      {
        "clash_mode": "global",
        "outbound": "Proxy"
      },
      {
        "domain": [
          "clash.razord.top",
          "yacd.metacubex.one",
          "yacd.haishan.me",
          "d.metacubex.one"
        ],
        "outbound": "direct"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "rule_set": "geosite-geolocation-!cn",
        "outbound": "Proxy"
      },
      {
        "rule_set": [
          "geoip-cn",
          "geosite-cn"
        ],
        "outbound": "direct"
      },
      {
        "action": "route-options",
        "udp_disable_domain_unmapping": true,
        "udp_connect": true
      },
      {
        "action": "resolve"
      }
    ],
    "rule_set": [
      {
        "tag": "geosite-category-ads-all",
        "type": "remote",
        "format": "binary",
        "url": "https://ghfast.top/raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/category-ads-all.srs",
        "http_client": "direct-download"
      },
      {
        "tag": "geosite-geolocation-!cn",
        "type": "remote",
        "format": "binary",
        "url": "https://ghfast.top/raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/geolocation-!cn.srs",
        "http_client": "direct-download"
      },
      {
        "tag": "geoip-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://ghfast.top/raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geoip/cn.srs",
        "http_client": "direct-download"
      },
      {
        "tag": "geosite-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://ghfast.top/raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/cn.srs",
        "http_client": "direct-download"
      }
    ],
    "default_http_client": "direct-download"
  },
  "http_clients": [
    {
      "tag": "direct-download",
      "version": 2,
      "detour": "direct"
    }
  ]
}
